# Required for API calls. When api_proxy is used, this can be a local placeholder.
CLBENCH_OPENAI_API_KEY=""

# Generic fallback endpoint. GPT and Doubao use their provider-specific endpoint
# below when it is set.
CLBENCH_OPENAI_BASE_URL=""
CLBENCH_GPT_BASE_URL=""
CLBENCH_DOUBAO_BASE_URL=""

# Gemini-native and Claude-native endpoints.
CLBENCH_GEMINI_API_URL=""
CLBENCH_CLAUDE_API_URL=""

# Request and retry limits.
CLBENCH_API_TIMEOUT="1800"
CLBENCH_CLAUDE_TIMEOUT="1800"
CLBENCH_API_TIMEOUT_RETRIES="10"
CLBENCH_CLAUDE_TIMEOUT_RETRIES="10"
CLBENCH_CLAUDE_EMPTY_TEXT_RETRIES="3"

# Payload values are interpreted as MiB.
CLBENCH_PAYLOAD_SOFT_LIMIT_MB="18"
CLBENCH_GPT_PAYLOAD_SOFT_LIMIT_MB="18"
CLBENCH_DOUBAO_PAYLOAD_SOFT_LIMIT_MB="18"

# Multi-turn and long-context fallback behavior.
CLBENCH_HISTORY_MEDIA_POLICY="full"
CLBENCH_TEXT_COMPACT_MIN_CHARS="300000"
CLBENCH_HISTORY_TEXT_PREVIEW_CHARS="1200"
